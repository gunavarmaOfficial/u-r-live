# ==============================================================================
# U-R-LIVE Environment Configuration Template
# Strict ₹0 infrastructure budget: free-tier Postgres + Cloudflare free tier
# ==============================================================================

# Node Environment ('development' | 'production' | 'test')
NODE_ENV="development"
PORT=3000

# Session & Admin Security (HMAC-SHA256 Token Signing)
# Required in production; dev default used in development
SESSION_SECRET="replace_with_a_secure_random_64_char_hex_secret_in_production"
ADMIN_SECRET_KEY="replace_with_your_private_admin_secret_key"

# Database Configuration (Supabase PostgreSQL Free Tier)
# In production, DATABASE_URL or SUPABASE_DB_URL is MANDATORY (fail-closed, no JSON fallback).
# In local development, if unset, falls back to .data/omelive_db.json.
# Connection format for Supabase Transaction Pooler (recommended):
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# Optional: Supabase Direct REST/API Keys (Server-side ONLY - never expose to frontend)
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Web Application Base URL (public origin, used for canonical URLs, webhooks and OG tags)
PUBLIC_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# Public site URL baked into the frontend build (canonical, sitemap, JSON-LD)
VITE_SITE_URL="http://localhost:3000"

# Optional: backend origin for split deploys (static frontend on Vercel/Netlify,
# API + WebSocket server elsewhere). Leave empty for same-origin single-server.
# Must be https in production. Example: "https://api.u-r-live.com"
VITE_API_URL=""

# Origins allowed to call this API cross-origin (comma-separated). Required on
# the backend when VITE_API_URL points here from another host.
# Example: "https://u-r-live.vercel.app,https://www.u-r-live.com"
CORS_ORIGINS=""

# Version of the published Terms of Service / Privacy Policy (ISO date).
# Bump this when legal copy changes; users are re-prompted to accept.
LEGAL_TERMS_VERSION="2026-10-28"

# Google Sign-In (OAuth Web client ID). When empty, the Google button is hidden.
GOOGLE_CLIENT_ID=""

# Redis (managed Memorystore / Upstash) for multi-instance matchmaking and rate limits.
# When unset in development, an in-memory fallback is used. Required in production.
REDIS_URL=""

# Optional Managed TURN / STUN Relay Server (e.g. Coturn, Twilio, or Cloudflare Calls)
TURN_URL="turn:turn.example.com:3478"
TURN_USERNAME="turn_user"
TURN_CREDENTIAL="turn_credential"

# Cloudflare Turnstile Bot Protection (Free Tier)
# Get from Cloudflare Dashboard > Turnstile
TURNSTILE_SITE_KEY="0x4AAAAAAAx_YOUR_SITE_KEY"
TURNSTILE_SECRET_KEY="0x4AAAAAAAx_YOUR_SECRET_KEY"
TURNSTILE_REQUIRED="false" # Set "true" in production to strictly enforce bot challenges
TURNSTILE_FAIL_OPEN="true" # Fail-safe: if Cloudflare upstream times out, allow legitimate users

# Optional Gemini API Key
GEMINI_API_KEY="MY_GEMINI_API_KEY"
