{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "npm run build:client && npm run build:ssr && node scripts/prerender.mjs",
    "build:client": "NODE_ENV=production vite build",
    "build:ssr": "NODE_ENV=production vite build --ssr src/entry-server.tsx --outDir dist-ssr",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/server.mjs && esbuild server/migrate.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/migrate.mjs",
    "start": "node dist-server/server.mjs",
    "migrate": "tsx server/migrate.ts",
    "migrate:prod": "node dist-server/migrate.mjs",
    "start:dev": "tsx server.ts",
    "test": "vitest run",
    "clean": "rm -rf dist dist-ssr dist-server server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@hugeicons/react": "^1.1.10",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-react": "^6.1.1",
    "compression": "^1.8.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "hugeicons-react": "^0.4.0",
    "ioredis": "^5.8.2",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.9.5",
    "vite": "^8.3.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
